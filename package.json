{
  "name": "whisper-live-prompter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pvq2233/yusui-prompter.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "electron desktop/main.cjs",
    "build:desktop": "node desktop/build-client.cjs",
    "check:release": "node scripts/check-release.cjs",
    "test:release": "node --test scripts/check-release.test.cjs",
    "test:desktop": "playwright test --config desktop-test.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "44.4.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
